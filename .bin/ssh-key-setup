#!/usr/bin/env bash
# Collision-safe generation. Bash 3.2 or newer.
set -Eeuo pipefail
SCRIPT_NAME=ssh-key-setup
. "$(dirname "$0")/common"
SCRIPT_VERSION=2.0.0
# Keep stdout machine-readable; never print failing command arguments.
log_info() { [[ "$QUIET" -eq 1 ]] || printf 'INFO %s\n' "$*" >&2; }
trap 'log_error "Operation failed; inspect reported paths before explicit cleanup."; exit 1' ERR

usage() {
  printf '%s\n' 'Usage: ssh-key-setup [options] <nickname> <purpose>

Generate id_ed25519_<nickname>_<purpose>, comment: <nickname> <purpose>.
Labels must match [a-z][a-z0-9_-]*. No hostname guessing or sanitizing.
SSH_DIR overrides $HOME/.ssh. Existing directories are not chmodded.
OpenSSH prompts for a passphrase; no passphrase CLI option is provided.

  -h, --help                Show help
      --version             Show version
  -v, --verbose             Increase verbosity
  -q, --quiet               Suppress informational diagnostics
  -n, --dry-run             Show intent only; no writes or tool execution
      --replacement-name NAME
                            Distinct id_ed25519_<nickname>_<purpose>_<suffix>
                            Suffix must match [a-z0-9][a-z0-9_-]*
      --load-agent          Load generated key into existing agent
      --copy                Copy public key (pbcopy, xclip, or xsel)
      --open-url URL        Open explicit https:// URL in browser
      --check-remote HOST   Explicit SSH smoke test, isolated key/config

-f/--force removed: collisions always fail, including dangling symlinks.
Default has no agent, clipboard, browser, or remote side effects.
Success emits one JSON registry-entry suggestion on stdout. Review before
merging into registry; dates, backup, replaces remain null, scope unknown,
authorized empty. No registry is read or edited. For rotation, link replaces
only after reviewing old fingerprint. Failed generation/publication reports
partial new paths for explicit cleanup; never removes existing material.

Examples (live generation requires separate approval):
  ssh-key-setup -n airborne forgejo
  ssh-key-setup -n --replacement-name id_ed25519_airborne_forgejo_2027 airborne forgejo'
}

valid_label() { [[ "$1" =~ ^[a-z][a-z0-9_-]*$ ]]; }
refuse_collision() {
  local path
  for path in "$@"; do
    [[ ! -e "$path" && ! -L "$path" ]] || die "Collision; refusing existing path: $path"
  done
}
show_command() { printf '+' >&2; printf ' %q' "$@" >&2; printf '\n' >&2; }

main() {
  local replacement='' agent=0 copy=0 url='' remote='' nickname purpose
  local clipboard='' browser='' arg
  local positional=()
  while [[ $# -gt 0 ]]; do
    arg=$1
    shift
    case "$arg" in
      -h|--help) usage; return 0 ;;
      --version) print_version; return 0 ;;
      -v|--verbose) VERBOSE=$((VERBOSE+1)) ;;
      -q|--quiet) QUIET=1 ;;
      -n|--dry-run) DRY_RUN=1 ;;
      -f|--force) die "--force removed; existing keys cannot be overwritten." ;;
      --load-agent) agent=1 ;;
      --copy) copy=1 ;;
      --replacement-name|--open-url|--check-remote)
        [[ $# -gt 0 && -n "$1" && "$1" != -* ]] || die "Missing value for $arg"
        case "$arg" in
          --replacement-name) replacement=$1 ;;
          --open-url) url=$1 ;;
          --check-remote) remote=$1 ;;
        esac
        shift ;;
      --) positional+=("$@"); break ;;
      -*) die "Unknown option: $arg" ;;
      *) positional+=("$arg") ;;
    esac
  done
  [[ ${#positional[@]} -eq 2 ]] || die "Explicit nickname and purpose required; see --help."
  nickname=${positional[0]}; purpose=${positional[1]}
  valid_label "$nickname" && valid_label "$purpose" || die "Invalid nickname or purpose."
  local name="id_ed25519_${nickname}_${purpose}" suffix
  if [[ -n "$replacement" ]]; then
    [[ "$replacement" == "${name}_"* ]] || die "Replacement must use distinct ${name}_<suffix> name."
    suffix=${replacement#"${name}_"}
    [[ "$suffix" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "Invalid replacement suffix."
    name=$replacement
  fi
  [[ -z "$url" || "$url" =~ ^https://[a-zA-Z0-9][a-zA-Z0-9./:_?=\&%+-]*$ ]] || die "Expected explicit https:// URL."
  [[ -z "$remote" || "$remote" =~ ^[a-zA-Z0-9][a-zA-Z0-9@._-]*$ ]] || die "Invalid SSH host/user@host."
  local ssh_dir=${SSH_DIR:-$HOME/.ssh}
  [[ ! -L "$ssh_dir" ]] || die "SSH directory symlink refused."
  [[ ! -e "$ssh_dir" || -d "$ssh_dir" ]] || die "SSH directory is not a directory."
  local key_path="$ssh_dir/$name" pub_path="$ssh_dir/$name.pub"
  refuse_collision "$key_path" "$pub_path"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    show_command ssh-keygen -t ed25519 -a 100 -C "$nickname $purpose" -f '<private staging directory>/key'
    log_info "Would publish without overwrite: $key_path and $pub_path"
    [[ "$agent" -eq 0 ]] || show_command ssh-add "$key_path"
    [[ "$copy" -eq 0 ]] || log_info "Would copy $pub_path"
    [[ -z "$url" ]] || log_info "Would open $url"
    [[ -z "$remote" ]] || log_info "Would test $remote using only $key_path"
    log_info 'Would emit registry-entry suggestion after successful generation; fingerprint not yet known.'
    return 0
  fi
  require ssh-keygen jq mktemp cat mkdir chmod rm
  [[ "$agent" -eq 0 ]] || require ssh-add
  if [[ "$copy" -eq 1 ]]; then
    for arg in pbcopy xclip xsel; do
      if command -v "$arg" >/dev/null 2>&1; then clipboard=$arg; break; fi
    done
    [[ -n "$clipboard" ]] || die "No clipboard tool available."
  fi
  if [[ -n "$url" ]]; then
    for arg in open xdg-open; do
      if command -v "$arg" >/dev/null 2>&1; then browser=$arg; break; fi
    done
    [[ -n "$browser" ]] || die "No browser opener available."
  fi
  [[ -z "$remote" ]] || require ssh
  umask 077
  [[ -d "$ssh_dir" ]] || mkdir -m 700 -p "$ssh_dir"
  local stage fingerprint suggestion
  stage=$(mktemp -d "$ssh_dir/.ssh-key-setup.XXXXXXXX")
  chmod 700 "$stage"
  log_info "Staging new material: $stage; on failure inspect this directory for explicit cleanup."
  if ! ssh-keygen -t ed25519 -a 100 -C "$nickname $purpose" -f "$stage/key" >&2; then
    die "Generation failed; no destination published. Partial new output may remain: $stage"
  fi
  [[ -f "$stage/key" && ! -L "$stage/key" && -f "$stage/key.pub" && ! -L "$stage/key.pub" ]] || die "Incomplete generation; inspect $stage"
  if ! fingerprint=$(ssh-keygen -E sha256 -lf "$stage/key.pub"); then
    die "Fingerprint failed; inspect $stage"
  fi
  fingerprint=${fingerprint#* }; fingerprint=${fingerprint%% *}
  [[ "$fingerprint" =~ ^SHA256:[A-Za-z0-9+/]{43}$ ]] || die "Invalid generated fingerprint; inspect $stage"
  suggestion=$(jq -n --arg name "$name" --arg fp "$fingerprint" --arg purpose "$purpose" --arg device "$nickname" '
    {name:$name,fingerprint:$fp,purpose:$purpose,status:"active",
     holders:[{device:$device,path:$name,private_key_expected:true,material_state:"present",observed_at:null}],
     created:null,review_after_months:null,backup:null,replaces:null,
     authorization_scope_complete:false,notes:"Generated key; review protection and authorization scope.",authorized:[]}')
  # noclobber reserves each destination at open time, not merely in preflight.
  # Never use ssh-keygen on destination: its overwrite prompt is not a guard.
  # Retain all partial new output on failure; do not unlink another process's files.
  if ! (set -o noclobber; cat "$stage/key" > "$key_path"); then
    die "Private publication failed; inspect $key_path and $stage for explicit cleanup."
  fi
  if ! (set -o noclobber; cat "$stage/key.pub" > "$pub_path"); then
    die "Public publication failed; new private output remains at $key_path; inspect $pub_path and $stage for explicit cleanup."
  fi
  rm -rf "$stage"
  printf '%s\n' "$suggestion"
  log_info "Generated $key_path. Review suggestion; registry unchanged."
  [[ "$agent" -eq 0 ]] || ssh-add "$key_path"
  if [[ "$copy" -eq 1 ]]; then
    case "$clipboard" in
      pbcopy) pbcopy < "$pub_path" ;;
      xclip) xclip -selection clipboard < "$pub_path" ;;
      xsel) xsel --clipboard --input < "$pub_path" ;;
    esac
  fi
  [[ -z "$url" ]] || "$browser" "$url"
  if [[ -n "$remote" ]]; then
    # No user config, agent/default identities, password fallback, host-trust writes,
    # proxy commands, or automatic multiplex-session reuse.
    local output code=0
    output=$(ssh -F /dev/null -T -i "$key_path" -o IdentitiesOnly=yes -o IdentityAgent=none \
      -o BatchMode=yes -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no \
      -o StrictHostKeyChecking=yes -o UpdateHostKeys=no -o ControlMaster=no \
      -o ControlPath=none -o ConnectTimeout=10 "$remote" 2>&1) || code=$?
    if [[ "$code" -ne 0 && "$output" != *'successfully authenticated'* ]]; then
      die "Remote test unconfirmed (exit $code); generated pair remains."
    fi
    log_info 'Remote smoke test accepted; authorization metadata still requires review.'
  fi
}
main "$@"
