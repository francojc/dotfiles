#!/usr/bin/env bash

# tinycast-awake-watch — background watcher loop for tinycast-awake
#
# Spawned detached by `tinycast-awake watch`. Polls pgrep -f for a stored
# regex pattern; keeps caffeinate -di running while matches exist, stops it
# after a grace period of no matches.
#
# Pattern is read from $STATE_DIR/watch.pattern (not argv) so pgrep -f
# matching the pattern string cannot self-match this script.
#
# Name intentionally does NOT contain 'pi' so it never appears in a ps
# snapshot as a candidate match for the default pattern.

set -Eeuo pipefail

STATE_DIR="${TINYCAST_STATE_DIR:-$HOME/.local/state/tinycast}"

PATTERN_FILE="$STATE_DIR/watch.pattern"
WATCH_PID_FILE="$STATE_DIR/watch.pid"
WATCHER_PID_FILE="$STATE_DIR/watcher.pid"
LOG_FILE="$STATE_DIR/awake.log"

GRACE_SECONDS=15
POLL_SECONDS=5

_notify() {
  /usr/bin/osascript -e "display notification \"$2\" with title \"$1\"" \
    >/dev/null 2>&1 || true
}

_pid_alive() {
  local pid
  pid=$(cat "$WATCH_PID_FILE" 2>/dev/null) || return 1
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  ps -p "$pid" -o args= 2>/dev/null | grep -q -- 'caffeinate.*-d'
}

pattern=$(cat "$PATTERN_FILE" 2>/dev/null) || {
  echo "$(date -Iseconds) watcher: cannot read pattern from $PATTERN_FILE" >>"$LOG_FILE"
  exit 1
}
[[ -z "$pattern" ]] && {
  echo "$(date -Iseconds) watcher: empty pattern" >>"$LOG_FILE"
  exit 1
}

echo $$ >"$WATCHER_PID_FILE"
echo "$(date -Iseconds) watcher: started (pid=$$ pattern='$pattern')" >>"$LOG_FILE"

last_match_epoch=$(date +%s)

cleanup() {
  rm -f "$WATCHER_PID_FILE"
  echo "$(date -Iseconds) watcher: exiting" >>"$LOG_FILE"
}
trap cleanup EXIT INT TERM

while true; do
  # Detect running processes matching the pattern WITHOUT putting the pattern
  # in any process's argv (pgrep -f and awk -v both self-match). Pattern is
  # passed via env var (ENVIRON["pat"]) so neither ps nor awk have it in argv.
  # Using a temp file avoids SIGPIPE (which would surface as 141 under
  # pipefail) when awk exits early after finding a match.
  ps_out=$(mktemp)
  if ! SELF_PID="$$" pat="$pattern" ps -axo pid=,command= 2>/dev/null >"$ps_out"; then
    rm -f "$ps_out"
    ps_out=""
  fi
  if [[ -n "$ps_out" ]]; then
    matches=$(SELF_PID="$$" awk '
        BEGIN { pat = ENVIRON["pat"]; self = ENVIRON["SELF_PID"] }
        $1 != self && match($0, pat) { print $1; exit }
      ' pat="$pattern" "$ps_out") || matches=""
    rm -f "$ps_out"
  else
    matches=""
  fi

  if [[ -n "$matches" ]]; then
    last_match_epoch=$(date +%s)
    if ! _pid_alive; then
      /usr/bin/caffeinate -di </dev/null >>"$LOG_FILE" 2>&1 &
      pid=$!
      echo "$pid" >"$WATCH_PID_FILE"
      sleep 0.05
      if kill -0 "$pid" 2>/dev/null; then
        _notify "Mac Awake" "Watching '$pattern': sleep prevention enabled."
      else
        rm -f "$WATCH_PID_FILE"
      fi
    fi
  else
    now=$(date +%s)
    if (( now - last_match_epoch > GRACE_SECONDS )) && _pid_alive; then
      pid=$(cat "$WATCH_PID_FILE")
      kill "$pid" 2>/dev/null || true
      rm -f "$WATCH_PID_FILE"
      _notify "Mac Sleep" "Process '$pattern' gone. Sleep restored."
    fi
  fi

  sleep "$POLL_SECONDS"
done
