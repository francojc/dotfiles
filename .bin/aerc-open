#!/usr/bin/env bash
# aerc-open — open a file with the OS default app (macOS: open, Linux: xdg-open).
# Copies the file to a temp location first so it survives aerc's own cleanup.
set -euo pipefail

[ $# -ge 1 ] || { echo "usage: aerc-open FILE" >&2; exit 1; }
src="$1"
# Keep the extension (with its dot): xdg-open picks handlers by MIME type,
# and a missing dot ("aerc_XXXXXXhtml") makes it fall through to text/plain.
base=$(mktemp "${TMPDIR:-/tmp}/aerc_XXXXXX")
ext=""
case "$src" in *.*) ext=".${src##*.}" ;; esac
tmp="$base$ext"
mv "$base" "$tmp"
cp "$src" "$tmp"

case "$(uname -s)" in
  Darwin) exec open "$tmp" ;;
  *)      exec xdg-open "$tmp" ;;
esac
