# Quiet beach focus listening session (20 minutes)
# Sound design only; no cognitive outcome implied.

# Options
@samplerate 44100
@volume 80
@ambiance beach audio/freesound/freesound-721591

# Presets
settle
  ambiance beach amplitude 50
  tone 220 binaural 10 amplitude 20

focus
  ambiance beach amplitude 70
  tone 220 binaural 8 amplitude 15

# Timeline
00:00:00 silence
00:00:30 settle ease-in
00:05:00 focus smooth
00:17:00 focus smooth
00:19:00 settle ease-out
00:20:00 silence
