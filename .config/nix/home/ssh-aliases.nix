_:
let
  # Tailscale MagicDNS suffix for this tailnet.
  #
  # macOS will not apply the `gerbil-matrix.ts.net` search domain that
  # Tailscale installs. `scutil --dns` shows Tailscale's resolver as
  # `Supplemental`, and mDNSResponder only honours search domains from the
  # primary service resolver. Unqualified names therefore fall through to the
  # `.local` mDNS bucket (5s timeout, marked Not Reachable) and stall inside
  # getaddrinfo() before failing. `dig` reads /etc/resolv.conf directly, so it
  # resolves bare names while ssh, rsync and curl do not. Always write
  # HostName as a fully qualified name.
  tailnet = "gerbil-matrix.ts.net";

  # Tailnet boxes reachable by short alias, user is the login on that host.
  # No IdentityFile/IdentitiesOnly: let the agent or default keys decide.
  plainHosts = [
    { host = "monitors"; name = "monitor-services"; user = "jeridf"; }
    { host = "services"; name = "core-services"; user = "root"; }
    { host = "media"; name = "media-services"; user = "root"; }
    { host = "homeassistant"; name = "homeassistant"; user = "jeridf"; }
    { host = "hermes"; name = "hermes-agent"; user = "hermes"; }
    { host = "omarchy"; name = "omarchy"; user = "omarchy"; }
    { host = "proxmox"; name = "minis-proxmox"; user = "root"; }
  ];

  hostBlock = h:
    ''
      Host ${h.host}
        HostName ${h.name}.${tailnet}
        HostKeyAlias ${h.name}
        User ${h.user}
        Port 22
    '';
in
{
  home.file.".ssh/config.d/nix-managed.conf".text = ''
    # Generated by Home Manager. Do not edit directly.

    # Matches both the short alias and the literal FQDN, so existing git
    # remotes written as forgejo.${tailnet} keep using the right key.
    Host forgejo forgejo.${tailnet}
      HostName forgejo.${tailnet}
      HostKeyAlias forgejo
      User forgejo
      IdentityFile ~/.ssh/id_ed25519_forgejo
      IdentitiesOnly yes

    Host codeberg.org
      User git
      IdentityFile ~/.ssh/id_ed25519_codeberg
      IdentitiesOnly yes

    Host rover
      HostName mini-rover.${tailnet}
      HostKeyAlias mini-rover
      User jeridf
      Port 22

    Host minicore
      HostName mac-minicore.${tailnet}
      HostKeyAlias mac-minicore
      User jeridf
      Port 22
      IdentityFile ~/.ssh/id_ed25519_workstation
      IdentitiesOnly yes

    Host airborne
      HostName macbook-airborne.${tailnet}
      HostKeyAlias macbook-airborne
      User francojc
      Port 22
      IdentityFile ~/.ssh/id_ed25519_workstation
      IdentitiesOnly yes

    # --- tailnet boxes (generated) ---
    ${builtins.concatStringsSep "\n" (map hostBlock plainHosts)}
  '';
}
