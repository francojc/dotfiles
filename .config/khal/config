[default]
# No default calendar: khal must never create an event implicitly.
highlight_event_days = True
show_all_days = True

[highlight_days]
method = fg
multiple = "#FB4934"

[keybindings]
external_edit = ctrl g

[locale]
local_timezone= America/New_York
timeformat = %H:%M
dateformat = %Y-%m-%d
longdateformat = %Y-%m-%d
datetimeformat = %Y-%m-%d %H:%M
longdatetimeformat = %Y-%m-%d %H:%M
weeknumbers = right

[view]
# event_view_always_visible = True
event_view_weighting = 2

[palette]
# Gruvbox Dark Hard theme
# Format: foreground, background, mono, foreground_high, background_high

# General UI elements
header = light gray, '', '', '#EBDBB2', '#282828'
footer = light gray, '', '', '#EBDBB2', '#282828'
line header = light gray, '', '', '#EBDBB2', ''
alt header = light gray, '', '', '#FBF1C7', '#282828'
bright = white, '', 'bold', '#FBF1C7', ''

# List elements
list = light gray, '', '', '#EBDBB2', ''
list focused = white, dark blue, 'bold', '#FBF1C7', '#458588'

# Edit mode
edit = light gray, '', '', '#EBDBB2', ''
edit focus = white, dark blue, '', '#FBF1C7', '#458588'

# Buttons
button = light gray, '', '', '#EBDBB2', ''
button focused = white, dark blue, 'bold', '#FBF1C7', '#458588'

# Focus and highlighting
reveal focus = white, dark blue, '', '#FBF1C7', '#458588'
today focus = black, yellow, 'bold', '#282828', '#FABD2F'
today = white, dark green, 'bold', '#FBF1C7', '#98971A'

# Date headers
date header = light gray, '', '', '#EBDBB2', ''
date header focused = white, dark blue, '', '#FBF1C7', '#458588'
date header selected = white, dark blue, 'bold', '#FBF1C7', '#458588'

# Calendar elements
dayname = light gray, '', '', '#EBDBB2', ''
monthname = light gray, '', 'bold', '#EBDBB2', ''
weeknumber_right = dark gray, '', '', '#928374', ''

# Alerts and marks
alert = light red, '', 'bold', '#FB4934', ''
mark = yellow, '', '', '#FABD2F', ''

# Frames
frame = dark gray, '', '', '#928374', ''
frame focus = light gray, '', '', '#EBDBB2', ''
frame focus color = '', '', '', '', '#282828'
frame focus top = light gray, '', 'bold', '#EBDBB2', ''

# Event display
eventcolumn = dark red, '', '', '#EBDBB2', ''
eventcolumn focus = white, dark blue, '', '#FBF1C7', '#458588'

# Calendar view
calendar = light gray, '', '', '#EBDBB2', ''

# Popups and dialogs
editbx = light gray, '', '', '#EBDBB2', '#282828'
editcp = light gray, '', '', '#EBDBB2', '#282828'
popupbg = light gray, '', '', '#EBDBB2', '#282828'
popupper = light gray, '', '', '#EBDBB2', '#282828'
caption = light gray, '', '', '#EBDBB2', ''

