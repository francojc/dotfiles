[292] (w=71)    build.                                                              [0m]8;;
[293] (w=71) [38;2;218;186;250m2. [39m[1m[38;2;218;186;250mcontainer machine[39m (persistent VM from an OCI image with [38;2;218;186;250m/sbin/init[39m)[22m [0m]8;;
[294] (w=71)    → this is your runtime home: long-lived, persistent fs, home        [0m]8;;
