# Radian Configuration
# Organized into logical sections for better readability and maintenance

# Color and Appearance
options(
  radian.color_scheme = "native",
  radian.tab_size = 2,
  radian.auto_width = TRUE
)

# Editing Mode Configuration
options(
  radian.editing_mode = "vi",
  radian.emacs_bindings_in_vi_insert_mode = TRUE,
  radian.show_vi_mode_prompt = TRUE
)

# Vi Mode Prompts
options(
  radian.vi_mode_prompt = list(
    "ins" = "\033[0;34m>\033[0m",
    "nav" = "\033[0;33m□\033[0m",
    "rep" = "\033[0;31m␣\033[0m"
  )
)

# Prompt Styles
options(
  radian.prompt = "\033[0;34m\033[0m ",
  radian.shell_prompt = "\033[0;31m#!>\033[0m ",
  radian.browse_prompt = "\033[0;33mBrowse[{}]>\033[0m "
)

# Completion and Suggestion Settings
options(
  radian.complete_while_typing = TRUE,
  radian.auto_suggest = TRUE,
  radian.completion_prefix_length = 4
)

# History Configuration
options(
  radian.global_history_file = "~/.radian_history",
  radian.history_search_no_duplicates = TRUE
)

# Bracket and Syntax Highlighting
options(
  radian.auto_match = FALSE,
  radian.highlight_matching_bracket = TRUE
)

# Custom Keybindings
options(
  radian.ctrl_key_map = list(
    list(key = "o", value = " <- "),
    list(key = "p", value = " |> ")
  )
)

# Completion Menu Colors
# The completion popup is styled by prompt_toolkit, independently of
# radian.color_scheme (which only drives syntax highlighting). Override it via
# an on-load hook. Requires the reticulate R package.
options(
  radian.on_load_hooks = list(function() {
    reticulate::py_run_string("
from radian.app import get_app
from prompt_toolkit.styles import Style, merge_styles

session = get_app().session
session.style = merge_styles([
    session.style,
    Style.from_dict({
        'completion-menu.completion': 'bg:#303030 #eeeeee',
        'completion-menu.completion.current': 'bg:#005f87 #ffffff',
        'completion-menu.meta.completion': 'bg:#303030 #bbbbbb',
        'completion-menu.meta.completion.current': 'bg:#005f87 #ffffff',
        'completion-menu.scrollbar.background': 'bg:#444444',
        'completion-menu.scrollbar.button': 'bg:#888888',
    }),
])
")
  })
)

