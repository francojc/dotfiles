# ==========================================================
# .gitignore - Project Exclusions
# ==========================================================
# Organized by category for maintainability

# ----------------------------------------------------------
# Operating System Files
# ----------------------------------------------------------
.DS_Store

# ----------------------------------------------------------
# Environment & Configuration Files
# ----------------------------------------------------------
.env
.variables.env
.config/pi-cron/env

# Application configuration directories
# Browser profiles are runtime state/cache, not portable dotfiles.
.config/BraveSoftware/
.config/fiskeretta/

# Home Manager writes generated symlinks into XDG config on NixOS.
# The declarative sources live under .config/nix/home/*.nix instead.
.config/direnv/
.config/environment.d/
.config/fontconfig/
.config/git/
.config/hypr/
.config/quickshell/
.config/systemd/
.config/tmux/
.config/wezterm/
.tmux/plugins/

# Runtime/generated app state that should live in real ~/.config, not dotfiles.
.config/aerc/google-aerc-credentials.json
.config/aerc/token.pickle
.config/bifrost-gateway/
.config/carapace/
.config/gh/
.config/gh/*
.config/git/*
.config/hunk/state.json
.config/kitty/kitty.conf
.config/llama/llama-api-key
.config/matcha/*
.config/mole/*
.config/nicotine/*
.config/nvim/lua/theme-config.lua
.config/nvim/nvim-pack-lock.json
.config/opencode/opencode.json
.config/pianobar/state
.config/pulse/*
.config/raycast/*
.config/rclone/rclone.conf
.config/tmux/*
.config/wezterm/wezterm.lua

# ----------------------------------------------------------
# Development Tools & AI Assistants
# ----------------------------------------------------------
# Aider AI development tool
.aider.chat*
.aider.input*
.aider.tags*

# Pi coding agent
.pi/agent/PI-INVENTORY.local.md
.pi/agent/auth.json
.pi/agent/google-workspace/
.pi/agent/models-store.json
.pi/agent/pi-crash.log
.pi/agent/pi-guide-autoupdate-state.json
.pi/agent/pi-guide-autoupdate.lock
.pi/agent/pi-guide-maintainer.log
.pi/agent/pi-last-notification.json
.pi/agent/pi-typesafe/
.pi/agent/pi-waiting-events.jsonl
.pi/agent/sessions/*
.pi/agent/settings.json
.pi/agent/themes/
.pi/agent/trust.json
.pi/agent/models-store.json
.pi/models/

